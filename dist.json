{
    "author": "ryan@rsg.io",
    "targets": {
        "bin": {
            "source": "bin/*",
            "destination": "{DEPLOY_ROOT}/bin/%1"
        },
        "env": {
            "source": "hashio.env",
            "destination": "{DEPLOY_ROOT}/env/hashio.env"
        },
        "lib": {
            "source": "lib/hashio",
            "destination": "{DEPLOY_ROOT}/lib/python/hashio"
        }
    }
}